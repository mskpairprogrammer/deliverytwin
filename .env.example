# Delivery Twin settings. Copy to .env (git-ignored) at the repository root or in src/, fill in what you use,
# and restart the server. Variables already set in the environment win over this file. On Azure App Service,
# set the same names as application settings (infra/main.bicep does this for you).

# --- AI model ---------------------------------------------------------------------------------------------
# In Azure the app uses Microsoft Foundry models only. Locally the order is: recorded demo answers >
# Databricks Model Serving > Foundry > OpenAI > rules-based.
OPENAI_API_KEY=                     # local testing only; ignored on Azure App Service
OPENAI_MODEL=gpt-4o-mini
# DELIVERYTWIN_AI_MODE=recorded   # replay sample answers with no key or internet

# --- Microsoft Foundry ------------------------------------------------------------------------------------
# Master switch: 1 = use the settings below, 0 = ignore them, blank = use them whenever they are filled in.
DELIVERYTWIN_FOUNDRY_ENABLED=0
FOUNDRY_PROJECT_ENDPOINT=           # https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=                      # model deployment name, e.g. gpt-4o-mini (AI features and the chat agent)
FOUNDRY_ENDPOINT=                   # optional: model endpoint; default derived from the project (https://<resource>.services.ai.azure.com)
FOUNDRY_API_KEY=                    # optional, local only: blank signs in with az login / managed identity
FOUNDRY_API_VERSION=                # blank selects the API version for the endpoint type

# --- Azure Databricks -------------------------------------------------------------------------------------
# Master switch: 1 = use the settings below, 0 = ignore them, blank = use them whenever they are filled in.
DELIVERYTWIN_DATABRICKS_ENABLED=0
DATABRICKS_HOST=                    # https://adb-<id>.<n>.azuredatabricks.net
DATABRICKS_TOKEN=                   # or DATABRICKS_CLIENT_ID + DATABRICKS_CLIENT_SECRET (service principal)
# Data: all app tables use Unity Catalog / Delta when enabled and the warehouse path is set.
DATABRICKS_HTTP_PATH=               # /sql/1.0/warehouses/<warehouse-id>
DELIVERYTWIN_CATALOG=dpm_dev
DELIVERYTWIN_SCHEMA=mlops
# AI (local runs only; Azure uses Foundry models): a Model Serving chat endpoint, tried before Foundry.
DATABRICKS_SERVING_ENDPOINT=        # endpoint name

# --- Local runtime ----------------------------------------------------------------------------------------
# DELIVERYTWIN_DB_PATH=deliverytwin.duckdb   # DuckDB file (App Service: /home/data/deliverytwin.duckdb)
# DELIVERYTWIN_DEMO_MODE=1                   # simulation lab plus data reset and reload
# DELIVERYTWIN_BLENDED_RATE=150              # mock labor rate (USD/hour) behind recovery cost impact
